# SIGMA 1 — environment variables (template)
# Copy to .env.local for local development. NEVER commit real values; .env and .env.* are git-ignored.
#
# ---------------------------------------------------------------------------------------------
# 1) BROWSER (Vite) — anything prefixed VITE_ is bundled into the public JavaScript.
#    Only put values here that are SAFE TO PUBLISH.
# ---------------------------------------------------------------------------------------------

# Supabase project URL (public).
VITE_SUPABASE_URL=https://your-project-ref.supabase.co

# Supabase publishable key (sb_publishable_...). Safe in the browser ONLY because every table has
# Row Level Security enabled. Never put the secret / service-role key here.
VITE_SUPABASE_PUBLISHABLE_KEY=sb_publishable_your-key-here
# Legacy name, still accepted if the one above is missing:
# VITE_SUPABASE_ANON_KEY=your-legacy-anon-key

# Web Push public (VAPID) key — public by design; the private half stays server-side.
VITE_VAPID_PUBLIC_KEY=your-vapid-public-key

# The one address that registers devices for push alerts (prevents duplicate alerts from previews).
VITE_PUSH_ORIGIN=https://your-production-domain.example

# ---------------------------------------------------------------------------------------------
# 2) SERVER ONLY — Supabase Edge Function secrets. Set them with the Supabase CLI or dashboard:
#      supabase secrets set NAME=value
#    They must NEVER appear in VITE_ variables, frontend code, or git.
# ---------------------------------------------------------------------------------------------

# Provided automatically by Supabase inside Edge Functions (do not set by hand):
# SUPABASE_URL=
# SUPABASE_SERVICE_ROLE_KEY=        # bypasses RLS — server only, never in the browser

# Web Push keys (generate with: npx web-push generate-vapid-keys)
# VAPID_PUBLIC_KEY=your-vapid-public-key
# VAPID_PRIVATE_KEY=your-vapid-private-key          # SECRET
# VAPID_SUBJECT=mailto:admin@your-domain.example

# Links created by the server (setup / reset links, push click-through)
# APP_BASE_URL=https://your-production-domain.example
# APP_URL=https://your-production-domain.example
